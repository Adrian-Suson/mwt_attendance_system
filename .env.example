PORT=5000
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=attendance_db

# Google Drive uploads. Share GOOGLE_DRIVE_FOLDER_ID with the service account.
GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/google-service-account.json
GOOGLE_DRIVE_FOLDER_ID=
# Optional when the Shared-drive parent ID is not the Shared-drive root.
# GOOGLE_DRIVE_ID=
# Shared-drive access is inherited by uploaded files. Enable only if public links are allowed.
# GOOGLE_DRIVE_MAKE_PUBLIC=false
# Alternatively, set GOOGLE_SERVICE_ACCOUNT_JSON to the minified service-account JSON.
