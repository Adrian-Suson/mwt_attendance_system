PORT=5000
NODE_ENV=production
JWT_SECRET=replace-with-a-random-string-at-least-32-characters
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password-at-least-12-characters
DB_AUTO_CREATE=false
CORS_ORIGIN=https://your-frontend-domain.example
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=attendance_db

# Google Drive uploads. Share GOOGLE_DRIVE_FOLDER_ID with the service account.
GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/google-service-account.json
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_ID=
FACE_MODEL_DIR=./models/face-api
FACE_MATCH_THRESHOLD=0.55
FACE_MIN_CONFIDENCE=0.6
# Shared-drive access is inherited by uploaded files. Enable only if public links are allowed.
# GOOGLE_DRIVE_MAKE_PUBLIC=false
# For deployment, use a secret environment variable instead of a local file path:
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# Or use base64-encoded service-account JSON:
# GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
